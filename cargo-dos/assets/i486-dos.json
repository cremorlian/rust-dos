{
  "arch": "x86",
  "cpu": "i486",
  "data-layout": "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i128:128-f64:32:64-f80:32-n8:16:32-S128",
  "dynamic-linking": false,
  "executables": true,
  "function-sections": true,
  "link-script": "ENTRY(_start)\n\nPHDRS\n{\n  text PT_LOAD FLAGS(7);\n}\n\nSECTIONS\n{\n  . = 0;\n\n  .text : { *(.text .text.*) } :text\n  .rodata : { *(.rodata .rodata.*) } :text\n\n  /DISCARD/ : { *(.eh_frame) *(.eh_frame_hdr) }\n}\n",
  "linker": "rust-lld",
  "linker-flavor": "ld.lld",
  "pre-link-args": {
    "ld.lld": ["--emit-relocs", "--no-rosegment"]
  },
  "llvm-target": "i486-unknown-none",
  "max-atomic-width": 32,
  "os": "none",
  "panic-strategy": "abort",
  "position-independent-executables": false,
  "relocation-model": "static",
  "relro-level": "off",
  "target-c-int-width": 32,
  "target-endian": "little",
  "target-pointer-width": 32,
  "vendor": "unknown",
  "disable-redzone": true,
  "code-model": "small"
}